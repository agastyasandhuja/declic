{
  "name": "hackumass-14",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "npm run start --workspace @hackumass/mobile",
    "ios": "npm run ios --workspace @hackumass/mobile",
    "ios:instagram": "npm run ios:instagram --workspace @hackumass/mobile",
    "instagram:connect": "PYTHONPATH=services/api .local/instagram-probe/venv/bin/python -m app.modules.entertainment.instagram_connection",
    "instagram:check": "npm run instagram:connect -- --check",
    "instagram:api": "PYTHONPATH=services/api .local/instagram-probe/venv/bin/python -m uvicorn app.modules.entertainment.experiments.preview_app:create_live_app --factory --host 127.0.0.1 --port 8000 --no-access-log",
    "instagram:mobile": "HACKUMASS_INSTAGRAM_PREVIEW=0 EXPO_PUBLIC_FEED_SOURCE=api npm run start --workspace @hackumass/mobile -- --clear",
    "web": "npm run web --workspace @hackumass/mobile",
    "typecheck": "npm run typecheck --workspace @hackumass/mobile",
    "test": "npm run test --workspace @hackumass/mobile",
    "contracts:generate": "npm run contracts:generate --workspace @hackumass/mobile",
    "contracts:check": "npm run contracts:check --workspace @hackumass/mobile"
  }
}
