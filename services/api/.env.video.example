# Copy these into services/api/.env. Never commit actual keys.
ANTHROPIC_API_KEY=
VIDEO_CLAUDE_MODEL=claude-opus-5-5
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_PETER_VOICE_ID=
ELEVENLABS_STEWIE_VOICE_ID=
ELEVENLABS_NARRATOR_VOICE_ID=
VIDEO_VOICE_DISCLOSURE=AI voices
VIDEO_RENDER_IMAGE=hackumass-renderer:0.1
# concept_only is the research-informed default; gameplay is a comparison condition.
VIDEO_BACKGROUND_MODE=auto
MONGODB_URI=
MONGODB_DATABASE=hackumass
# Server-only storage, private bucket
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VIDEO_STORAGE_BUCKET=lesson-videos
