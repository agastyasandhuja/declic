# Server-only environment. Never copy these variables into apps/mobile.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Shared connection/client lifecycle and ordered migration assembly: Agastya.
MONGODB_URI=mongodb+srv://replace_user:replace_password@replace_cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hackumass14
# Inject decoded bytes into CatalogService; >=32 random bytes, shared by replicas.
ENTERTAINMENT_CURSOR_SECRET=replace_with_64_random_hex_characters
# Disposable local integration tests only; tests create/drop fresh adi_test_* DBs.
MONGODB_TEST_URI=mongodb://127.0.0.1:27018
