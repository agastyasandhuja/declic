# Gemini curriculum worker configuration (owner: Amogh). Placeholders only.
# Copy to services/api/.env.gemini.local (gitignored) and fill in real values.
# Never put these in mobile config, fixtures, prompts, logs or commits.

# Your Google AI Studio API key.
GEMINI_API_KEY=

# The model id your key can use. A fast "flash-lite" model is recommended for
# syllabus extraction: it answers in ~1-2s. Full "thinking" flash models (e.g.
# gemini-3.8-flash) are much slower (minutes) and were overloaded in testing.
# Model names change; run `python3 -m app.modules.curriculum.list_models` to
# see what your key supports.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Gemini 3 models default to "high" thinking (slow). "low" keeps
# extraction fast. Leave as-is unless you know you want deeper reasoning.
GEMINI_THINKING_LEVEL=low
