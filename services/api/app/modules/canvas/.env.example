# Canvas backend configuration (owner: Amogh). Placeholders only.
# Copy to services/api/.env.canvas.local (gitignored) and fill in real values there.
# Never put these in mobile config, fixtures, logs or prompts.

# Institution Canvas origin: https only, no path.
# UMass Amherst (the first school we support):
CANVAS_BASE_URL=https://umamherst.instructure.com

# Own-account demo mode: a personal access token from Canvas > Account > Settings.
# Bound to exactly one test app user; other users can never use it.
CANVAS_DEV_TOKEN=
CANVAS_DEV_TOKEN_APP_USER_ID=

# Institutional OAuth (only if the school's Canvas admins issue a developer key).
CANVAS_OAUTH_CLIENT_ID=
CANVAS_OAUTH_CLIENT_SECRET=
CANVAS_OAUTH_REDIRECT_URI=
