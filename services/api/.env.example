# Copy locally; never commit real credentials.
API_ENVIRONMENT=development
API_PERSISTENCE=mongodb
# MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DATABASE=hackumass
API_CORS_ORIGINS=[]
# Integrated runtime: uvicorn app.runtime:create_app --factory
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<project publishable key; never a service-role key>
# Required in production; stable across API instances and restarts (at least 32 chars).
# API_CATALOG_CURSOR_SECRET=<generate a random secret>
# Explicit local synthetic mode (not a MongoDB emulator or playable-media demo):
# API_ENVIRONMENT=fixture
# API_PERSISTENCE=fixture_sqlite
# API_FIXTURE_DATABASE_PATH=.local/api-fixture.db
# API_FIXTURE_TOKEN=<generate a random token of at least 32 characters>
