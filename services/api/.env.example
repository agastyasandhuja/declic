# Copy locally; never commit real credentials.
API_ENVIRONMENT=development
API_PERSISTENCE=mongodb
# Atlas connection string, server only.
MONGODB_URI=
MONGODB_DATABASE=hackumass
API_CORS_ORIGINS=[]
# Integrated runtime: uvicorn app.runtime:create_app --factory
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required in production; stable across API instances and restarts (at least 32 chars).
# API_CATALOG_CURSOR_SECRET=<generate a random secret>
# Explicit local synthetic mode (not a MongoDB emulator or playable-media demo):
# API_ENVIRONMENT=fixture
# API_PERSISTENCE=fixture_sqlite
# API_FIXTURE_DATABASE_PATH=.local/api-fixture.db
# API_FIXTURE_TOKEN=<generate a random token of at least 32 characters>

# Full demo assembly: python scripts/run-demo.py api
# AES-256-GCM key; generate once and keep stable to decrypt saved provider sessions:
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
CONNECTION_ENCRYPTION_KEY=
CANVAS_BASE_URL=https://umamherst.instructure.com
# Privileged server-only Storage credential, never EXPO_PUBLIC:
SUPABASE_SERVICE_ROLE_KEY=
VIDEO_STORAGE_BUCKET=lesson-videos
# Gemini configuration: copy .env.gemini.example to .env.gemini.local.

# Cost controls. Failed validation remains a failure; never bypass quality gates.
VIDEO_CLAUDE_MODEL=claude-sonnet-4-5
VIDEO_MAX_CLAUDE_CALLS=6
VIDEO_GENERATION_ENABLED=false
