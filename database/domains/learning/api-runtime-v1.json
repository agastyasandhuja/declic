  "api_idempotency": {
    "indexes": [
      {
        "keys": [
          "user_id",
          "route",
          "key"
        ],
        "unique": true
      }
    ],
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "properties": {
          "key": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "route": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "user_id": {
            "bsonType": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "required": [
          "key",
          "route",
          "user_id"
        ]
      }
    }
  },
  "api_jobs": {
    "indexes": [
      {
        "keys": [
          "job_id"
        ],
        "unique": true
      },
      {
        "keys": [
          "owner_user_id",
          "job_type",
          "dedupe_key"
        ],
        "unique": true
      },
      {
        "keys": [
          "job_type",
          "state",
          "available_at"
        ],
        "unique": false
      },
      {
        "keys": [
          "state",
          "lease_until"
        ],
        "unique": false
      }
    ],
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "properties": {
          "attempt_count": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "dedupe_key": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "input_ref": {
            "bsonType": "object"
          },
          "job_id": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "job_type": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "max_attempts": {
            "bsonType": [
              "int",
              "long"
            ],
            "maximum": 10,
            "minimum": 1
          },
          "owner_user_id": {
            "bsonType": "string",
            "maxLength": 128,
            "minLength": 1
          },
          "state": {
            "enum": [
              "queued",
              "running",
              "retry_wait",
              "succeeded",
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "dedupe_key",
          "job_id",
          "job_type",
          "owner_user_id",
          "state",
          "attempt_count",
          "max_attempts",
          "input_ref"
        ]
      }
    }
  },
