{
  "api_feed_events": {
    "indexes": [
      {
        "keys": [
          "user_id",
          "event_id"
        ],
        "unique": true
      }
    ],
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "properties": {
          "event_id": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "user_id": {
            "bsonType": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "required": [
          "event_id",
          "user_id"
        ]
      }
    }
  },
  "api_feed_occurrences": {
    "indexes": [
      {
        "keys": [
          "item_id"
        ],
        "unique": true
      },
      {
        "keys": [
          "session_id",
          "sequence"
        ],
        "unique": true
      },
      {
        "keys": [
          "user_id",
          "session_id",
          "sequence"
        ],
        "unique": false
      }
    ],
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "properties": {
          "data": {
            "bsonType": "object"
          },
          "item_id": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "sequence": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 1
          },
          "session_id": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "user_id": {
            "bsonType": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "required": [
          "item_id",
          "sequence",
          "session_id",
          "data",
          "user_id"
        ]
      }
    }
  },
  "api_feed_pages": {
    "indexes": [
      {
        "keys": [
          "page_id"
        ],
