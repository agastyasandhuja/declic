            ]
          },
          "page_id": {
            "bsonType": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "user_id": {
            "bsonType": "string",
            "maxLength": 128,
            "minLength": 1
          }
        },
        "required": [
          "page_id",
          "data",
          "user_id"
        ]
      }
    }
  },
