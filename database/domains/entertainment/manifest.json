{
  "draft_version": 1,
  "collections": [
    {
      "name": "entertainment_catalogs",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "user_id",
            "revision",
            "items",
            "updated_at",
            "expires_at"
          ],
          "properties": {
            "_id": {},
            "schema_version": {
              "enum": [
                "1"
              ]
            },
            "user_id": {
              "bsonType": "string",
              "minLength": 1
            },
            "revision": {
              "bsonType": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "items": {
              "bsonType": "array",
              "maxItems": 100,
              "items": {
                "bsonType": "object",
                "required": [
                  "schema_version",
                  "video_id",
                  "provider",
                  "provider_video_id",
                  "source_url",
                  "creator",
                  "caption",
                  "duration_seconds",
                  "playback",
                  "thumbnail_url",
                  "acquired_at",
                  "availability",
                  "acquisition_mode"
                ],
                "properties": {
                  "schema_version": {
                    "enum": [
                      "1"
                    ]
                  },
                  "video_id": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "provider": {
                    "enum": [
                      "tiktok",
                      "instagram",
                      "fixture"
                    ]
                  },
                  "provider_video_id": {
                    "bsonType": "string",
                    "minLength": 1
                  },
                  "source_url": {
                    "bsonType": [
                      "string",
                      "null"
                    ],
                    "pattern": "^https://"
                  },
                  "creator": {
                    "bsonType": "object",
                    "required": [
                      "handle",
                      "display_name",
                      "attribution_url"
                    ],
                    "properties": {
                      "handle": {
                        "bsonType": [
                          "string",
                          "null"
                        ]
                      },
                      "display_name": {
                        "bsonType": [
                          "string",
                          "null"
                        ]
                      },
                      "attribution_url": {
                        "bsonType": [
                          "string",
                          "null"
                        ],
                        "pattern": "^https://"
                      }
                    }
                  },
                  "caption": {
                    "bsonType": "string"
                  },
                  "duration_seconds": {
                    "bsonType": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "playback": {
                    "bsonType": "object",
                    "required": [
                      "kind",
                      "asset_id",
                      "url",
                      "expires_at",
                      "mime_type"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "mp4",
                          "hls",
                          "embed"
                        ]
                      },
                      "asset_id": {
                        "bsonType": "string",
                        "minLength": 1
                      },
                      "url": {
                        "bsonType": "string",
                        "pattern": "^https://"
                      },
                      "expires_at": {
                        "bsonType": [
                          "string",
                          "null"
                        ]
                      },
                      "mime_type": {
                        "bsonType": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "not": {
                      "required": [
                        "headers_ref"
                      ]
                    }
                  },
                  "thumbnail_url": {
                    "bsonType": [
                      "string",
                      "null"
                    ],
                    "pattern": "^https://"
                  },
                  "acquired_at": {
                    "bsonType": "string"
                  },
                  "availability": {
                    "enum": [
                      "ready",
                      "unavailable",
                      "needs_refresh"
                    ]
                  },
                  "acquisition_mode": {
                    "enum": [
                      "live",
                      "cached",
                      "fixture"
                    ]
                  }
                }
              }
            },
            "updated_at": {
              "bsonType": "date"
            },
            "expires_at": {
              "bsonType": "date"
            }
          }
        }
      },
      "indexes": [
        {
          "keys": [
            [
              "user_id",
              1
            ]
          ],
          "name": "catalog_owner_unique",
          "unique": true
        },
        {
          "keys": [
            [
              "expires_at",
              1
            ]
          ],
          "name": "catalog_expiry",
          "expireAfterSeconds": 0
        }
      ]
    }
  ]
}
