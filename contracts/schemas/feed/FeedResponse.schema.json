{
  "$defs": {
    "Availability": {
      "properties": {
        "entertainment": {
          "enum": [
            "ready",
            "unavailable"
          ],
          "title": "Entertainment",
          "type": "string"
        },
        "study": {
          "enum": [
            "ready",
            "unavailable"
          ],
          "title": "Study",
          "type": "string"
        }
      },
      "required": [
        "study",
        "entertainment"
      ],
      "title": "Availability",
      "type": "object"
    },
    "CourseContext": {
      "properties": {
        "course_id": {
          "title": "Course Id",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "course_id",
        "title",
        "objective_id"
      ],
      "title": "CourseContext",
      "type": "object"
    },
    "Creator": {
      "properties": {
        "attribution_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution Url"
        },
        "display_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "handle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Handle"
        }
      },
      "title": "Creator",
      "type": "object"
    },
    "EntertainmentCandidate": {
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "acquisition_mode": {
          "enum": [
            "live",
            "cached",
            "fixture"
          ],
          "title": "Acquisition Mode",
          "type": "string"
        },
        "availability": {
          "enum": [
            "ready",
            "unavailable",
            "needs_refresh"
          ],
          "title": "Availability",
          "type": "string"
        },
        "caption": {
          "default": "",
          "maxLength": 10000,
          "title": "Caption",
          "type": "string"
        },
        "comment_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment Count"
        },
        "creator": {
          "$ref": "#/$defs/Creator"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 86400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "like_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Like Count"
        },
        "playback": {
          "$ref": "#/$defs/Playback"
        },
        "provider": {
          "enum": [
            "tiktok",
            "instagram",
            "fixture"
          ],
          "title": "Provider",
          "type": "string"
        },
        "provider_video_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Provider Video Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thumbnail Url"
        },
        "video_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "video_id",
        "provider",
        "provider_video_id",
        "playback",
        "acquired_at",
        "availability",
        "acquisition_mode"
      ],
      "title": "EntertainmentCandidate",
      "type": "object"
    },
    "EntertainmentItem": {
      "properties": {
        "inserted_at": {
          "format": "date-time",
          "title": "Inserted At",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "entertainment_video",
          "title": "Kind",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "video": {
          "$ref": "#/$defs/EntertainmentCandidate"
        }
      },
      "required": [
        "item_id",
        "inserted_at",
        "reason_codes",
        "kind",
        "video"
      ],
      "title": "EntertainmentItem",
      "type": "object"
    },
    "Playback": {
      "properties": {
        "asset_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Asset Id",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "kind": {
          "enum": [
            "mp4",
            "hls",
            "embed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mime_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mime Type"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "asset_id",
        "url"
      ],
      "title": "Playback",
      "type": "object"
    },
    "QuizCard": {
      "properties": {
        "objective_ids": {
          "items": {
            "type": "string"
          },
          "title": "Objective Ids",
          "type": "array"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuizOption"
          },
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "quiz_id": {
          "title": "Quiz Id",
          "type": "string"
        },
        "quiz_instance_id": {
          "title": "Quiz Instance Id",
          "type": "string"
        },
        "related_video_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Video Ids",
          "type": "array"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "quiz_instance_id",
        "quiz_id",
        "revision",
        "objective_ids",
        "prompt",
        "options",
        "related_video_ids"
      ],
      "title": "QuizCard",
      "type": "object"
    },
    "QuizItem": {
      "properties": {
        "inserted_at": {
          "format": "date-time",
          "title": "Inserted At",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "quiz",
          "title": "Kind",
          "type": "string"
        },
        "quiz": {
          "$ref": "#/$defs/QuizCard"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "inserted_at",
        "reason_codes",
        "kind",
        "quiz"
      ],
      "title": "QuizItem",
      "type": "object"
    },
    "QuizOption": {
      "properties": {
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Option Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "option_id",
        "text"
      ],
      "title": "QuizOption",
      "type": "object"
    },
    "StudyItem": {
      "properties": {
        "constraint_relaxations": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Relaxations",
          "type": "array"
        },
        "course_context": {
          "$ref": "#/$defs/CourseContext"
        },
        "inserted_at": {
          "format": "date-time",
          "title": "Inserted At",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "const": "study_video",
          "title": "Kind",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "reason_text": {
          "title": "Reason Text",
          "type": "string"
        },
        "video": {
          "$ref": "#/$defs/StudySummary"
        }
      },
      "required": [
        "item_id",
        "inserted_at",
        "reason_codes",
        "kind",
        "video",
        "course_context",
        "reason_text"
      ],
      "title": "StudyItem",
      "type": "object"
    },
    "StudySummary": {
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "captions_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Captions Ref"
        },
        "duration_seconds": {
          "maximum": 60,
          "minimum": 30,
          "title": "Duration Seconds",
          "type": "number"
        },
        "format_id": {
          "title": "Format Id",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "learning_goal": {
          "title": "Learning Goal",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "notation": {
          "title": "Notation",
          "type": "string"
        },
        "objective_id": {
          "title": "Objective Id",
          "type": "string"
        },
        "playback": {
          "$ref": "#/$defs/Playback"
        },
        "schema_version": {
          "const": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "enum": [
            "private",
            "shared_generic"
          ],
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "const": "ready",
          "title": "Status",
          "type": "string"
        },
        "teaching_approach": {
          "title": "Teaching Approach",
          "type": "string"
        },
        "thumbnail_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Thumbnail Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "video_id": {
          "title": "Video Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "video_id",
        "objective_id",
        "format_id",
        "teaching_approach",
        "level",
        "language",
        "notation",
        "scope",
        "status",
        "title",
        "learning_goal",
        "duration_seconds",
        "asset_id",
        "playback",
        "thumbnail_url",
        "captions_ref"
      ],
      "title": "StudySummary",
      "type": "object"
    }
  },
  "properties": {
    "availability": {
      "anyOf": [
        {
          "$ref": "#/$defs/Availability"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "demo_mode": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Demo Mode"
    },
    "items": {
      "items": {
        "discriminator": {
          "mapping": {
            "entertainment_video": "#/$defs/EntertainmentItem",
            "quiz": "#/$defs/QuizItem",
            "study_video": "#/$defs/StudyItem"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EntertainmentItem"
          },
          {
            "$ref": "#/$defs/StudyItem"
          },
          {
            "$ref": "#/$defs/QuizItem"
          }
        ]
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "pending_quiz_instance_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Quiz Instance Id"
    },
    "recommendation_revision": {
      "title": "Recommendation Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "recommendation_revision",
    "items",
    "next_cursor",
    "pending_quiz_instance_id"
  ],
  "title": "FeedResponse",
  "type": "object"
}
