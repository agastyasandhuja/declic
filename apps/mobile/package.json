{
  "name": "@hackumass/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.119.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "json-schema-to-typescript": "^16.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "ios:instagram": "node --import tsx scripts/prepare-instagram.ts && HACKUMASS_INSTAGRAM_PREVIEW=1 expo start --ios --localhost --clear",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check"
  },
  "private": true
