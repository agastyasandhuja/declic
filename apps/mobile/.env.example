# Publishable app configuration only. Copy to .env (gitignored).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Leave empty for fixture playback. Live API requests require an HTTPS origin.
EXPO_PUBLIC_API_BASE_URL=
# fixture | api
EXPO_PUBLIC_FEED_SOURCE=fixture
# Development-only entry into synthetic demo mode; never authenticates API calls.
EXPO_PUBLIC_ENABLE_PREVIEW=true

# Optional institution origin configured by the Canvas backend; never a token.
EXPO_PUBLIC_CANVAS_ORIGIN=
