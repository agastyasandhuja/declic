{
  "schema_version": "1",
  "title": "Interest earns interest",
  "segments": [
    {
      "segment_id": "s1",
      "speaker_role": "narrator",
      "spoken_text": "Same rate, same two years. Why does one account end ten dollars ahead?",
      "fact_ids": [
        "simple",
        "year2"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s2",
      "speaker_role": "narrator",
      "spoken_text": "Start with one thousand dollars. No deposits. No withdrawals.",
      "fact_ids": [
        "principal"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s3",
      "speaker_role": "narrator",
      "spoken_text": "Ten percent is hypothetical, not a promised return.",
      "fact_ids": [
        "assumption"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s4",
      "speaker_role": "narrator",
      "spoken_text": "Year one adds one hundred dollars of interest, giving eleven hundred.",
      "fact_ids": [
        "year1"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s5",
      "speaker_role": "narrator",
      "spoken_text": "Simple interest keeps paying ten percent of the original thousand. Another hundred makes twelve hundred after two years.",
      "fact_ids": [
        "simple"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s6",
      "speaker_role": "narrator",
      "spoken_text": "Compound interest takes ten percent of eleven hundred instead: one hundred ten dollars, giving twelve hundred ten.",
      "fact_ids": [
        "year2"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s7",
      "speaker_role": "narrator",
      "spoken_text": "That extra ten dollars is interest earned on last year's interest.",
      "fact_ids": [
        "year2",
        "assumption"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s8",
      "speaker_role": "narrator",
      "spoken_text": "Ten extra dollars. The interest earned interest.",
      "fact_ids": [
        "assumption",
        "simple",
        "year2"
      ],
      "delivery": "emphatic"
    }
  ],
