{
  "schema_version": "1",
  "title": "Reverse a linked list",
  "segments": [
    {
      "segment_id": "seg1",
      "speaker_role": "narrator",
      "spoken_text": "Reversing pointers will lose the rest of the chain!",
      "fact_ids": [
        "save"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "seg2",
      "speaker_role": "narrator",
      "spoken_text": "Not if you remember where two is before you touch one. At node one, we grab two and stash it.",
      "fact_ids": [
        "save"
      ],
      "delivery": "emphatic"
    },
    {
      "segment_id": "seg3",
      "speaker_role": "narrator",
      "spoken_text": "Now flip one's next pointer back to null, then slide previous up to one and current over to two.",
      "fact_ids": [
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg4",
      "speaker_role": "narrator",
      "spoken_text": "So at two you save three, reverse two's link toward one, and jump forward?",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "seg5",
      "speaker_role": "narrator",
      "spoken_text": "Exactly. Then at three we save null, aim three's next pointer back at two, and step into null.",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg6",
      "speaker_role": "narrator",
      "spoken_text": "Wait, current is null now. Did we just lose everything?",
      "fact_ids": [
        "return"
      ],
      "delivery": "sarcastic"
    },
    {
      "segment_id": "seg7",
      "speaker_role": "narrator",
      "spoken_text": "Nope! Previous holds three, our new head. The list runs three, two, one.",
      "fact_ids": [
        "return"
      ],
      "delivery": "emphatic"
    }
  ],
