{
  "schema_version": "1",
  "title": "Reverse a linked list",
  "segments": [
    {
      "segment_id": "s0",
      "speaker_role": "peter",
      "spoken_text": "Can I reverse a linked list by just turning the first arrow around? Seems easy.",
      "fact_ids": [],
      "delivery": "neutral"
    },
    {
      "segment_id": "s1",
      "speaker_role": "stewie",
      "spoken_text": "Brilliant. You just lost the rest of the list. Start with one, two, three. Previous is null and current is one.",
      "fact_ids": [],
      "delivery": "neutral"
    },
    {
      "segment_id": "s2",
      "speaker_role": "stewie",
      "spoken_text": "Save two first. Point one to null. Move previous to one and current to two.",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s3",
      "speaker_role": "peter",
      "spoken_text": "So I keep a bookmark before I change the link?",
      "fact_ids": [],
      "delivery": "neutral"
    },
    {
      "segment_id": "s4",
      "speaker_role": "stewie",
      "spoken_text": "Exactly. Save three next. Point two back to one. Move previous to two and current to three.",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s5",
      "speaker_role": "stewie",
      "spoken_text": "Save null at the end. Point three back to two. Move previous to three and current to null.",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s6",
      "speaker_role": "stewie",
      "spoken_text": "Return previous: three, two, one, null. Save, reverse, advance. Even your bookmarks have a purpose now.",
      "fact_ids": [
        "return"
      ],
      "delivery": "neutral"
    }
  ],
