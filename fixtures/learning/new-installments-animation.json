{
  "schema_version": "1",
  "title": "Twenty-five dollars is not the price",
  "segments": [
    {
      "segment_id": "s1",
      "speaker_role": "narrator",
      "spoken_text": "Those headphones are twenty-five dollars? That is one payment, not the price.",
      "fact_ids": [
        "split"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s2",
      "speaker_role": "narrator",
      "spoken_text": "Imagine a hundred-dollar pair split into four equal payments of twenty-five, with no interest or fees.",
      "fact_ids": [
        "split",
        "terms"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s3",
      "speaker_role": "narrator",
      "spoken_text": "Buy three hundred-dollar items on the same day, and those small payments stack up together.",
      "fact_ids": [
        "stack"
      ],
      "delivery": "emphatic"
    },
    {
      "segment_id": "s4",
      "speaker_role": "narrator",
      "spoken_text": "With identical schedules, each payment point needs seventy-five dollars. Not twenty-five. Each purchase still needs its share.",
      "fact_ids": [
        "stack"
      ],
      "delivery": "emphatic"
    },
    {
      "segment_id": "s5",
      "speaker_role": "narrator",
      "spoken_text": "Three purchases mean three hundred dollars committed altogether. Splitting that amount did not make anything cheaper.",
      "fact_ids": [
        "total"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s6",
      "speaker_role": "narrator",
      "spoken_text": "Seventy-five now still means three hundred in total, with two hundred twenty-five left to pay.",
      "fact_ids": [
        "total"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s7",
      "speaker_role": "narrator",
      "spoken_text": "Real plans vary: interest or fees may apply. Check the whole commitment, not just the small payment.",
      "fact_ids": [
        "terms",
        "total"
      ],
      "delivery": "emphatic"
    }
  ],
