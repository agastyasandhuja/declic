{
  "schema_version": "1",
  "title": "The universe has a structure",
  "segments": [
    {
      "segment_id": "seg1",
      "speaker_role": "narrator",
      "spoken_text": "The universe isn't just a random cloud of stars.",
      "fact_ids": [
        "web"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "seg2",
      "speaker_role": "narrator",
      "spoken_text": "Galaxies are systems of stars, gas, dust and dark matter held together by gravity.",
      "fact_ids": [
        "galaxy"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg3",
      "speaker_role": "narrator",
      "spoken_text": "And galaxies don't drift alone. They gather into groups and clusters.",
      "fact_ids": [
        "clusters"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg4",
      "speaker_role": "narrator",
      "spoken_text": "On large scales, these galaxies trace filaments and sheets around immense relatively empty voids.",
      "fact_ids": [
        "web",
        "scale"
      ],
      "delivery": "emphatic"
    },
    {
      "segment_id": "seg5",
      "speaker_role": "narrator",
      "spoken_text": "Together, they make a cosmic web. Gravity pulls matter together and helps this structure develop over time.",
      "fact_ids": [
        "web",
        "gravity"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg6",
      "speaker_role": "narrator",
      "spoken_text": "This is a distribution of matter, not one solid wall or a literal web of strings. The animation is illustrative, not to scale.",
      "fact_ids": [
        "scale"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg7",
      "speaker_role": "narrator",
      "spoken_text": "A vast pattern, shaped by gravity.",
      "fact_ids": [
        "web",
        "gravity",
        "scale"
      ],
      "delivery": "emphatic"
    }
  ],
