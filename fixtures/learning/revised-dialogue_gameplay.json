{
  "schema_version": "1",
  "title": "Reverse a Linked List Without Losing It",
  "segments": [
    {
      "segment_id": "s1",
      "speaker_role": "stewie",
      "spoken_text": "Peter, you flipped one arrow and lost two whole nodes. How?",
      "fact_ids": [
        "save"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s2",
      "speaker_role": "peter",
      "spoken_text": "Easy. Previous is None, so I pointed node one's next pointer at None.",
      "fact_ids": [
        "reverse"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s3",
      "speaker_role": "stewie",
      "spoken_text": "Bold. And node two? Unreachable. You flipped before saving.",
      "fact_ids": [
        "save"
      ],
      "delivery": "sarcastic"
    },
    {
      "segment_id": "s4",
      "speaker_role": "peter",
      "spoken_text": "Fine. Save the next pointer first, so two stays reachable. Then flip one's next pointer to None.",
      "fact_ids": [
        "save",
        "reverse"
      ],
      "delivery": "emphatic"
    },
    {
      "segment_id": "s5",
      "speaker_role": "stewie",
      "spoken_text": "Then previous moves to one, and current moves to two?",
      "fact_ids": [
        "advance"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s6",
      "speaker_role": "peter",
      "spoken_text": "Yep. Node two: save three, point two back at one.",
      "fact_ids": [
        "save",
        "reverse"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s7",
      "speaker_role": "stewie",
      "spoken_text": "Then advance, without losing anything this time. Growth.",
      "fact_ids": [
        "advance"
      ],
      "delivery": "sarcastic"
    },
    {
      "segment_id": "s8",
      "speaker_role": "peter",
      "spoken_text": "Node three: save None, point three at two, step forward.",
      "fact_ids": [
        "save",
        "reverse",
        "advance"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s9",
      "speaker_role": "stewie",
      "spoken_text": "So the new head is current?",
      "fact_ids": [
        "return"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s10",
      "speaker_role": "peter",
      "spoken_text": "Nope, current is None. Return previous: three, two, one. Saving first meant nothing vanished.",
      "fact_ids": [
        "return",
        "save"
      ],
      "delivery": "emphatic"
    }
  ],
