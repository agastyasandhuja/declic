{
  "schema_version": "1",
  "title": "The turtle without a hard shell",
  "segments": [
    {
      "segment_id": "seg1",
      "speaker_role": "narrator",
      "spoken_text": "The largest sea turtle doesn't have the shell you'd expect.",
      "fact_ids": [
        "size",
        "shell"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "seg2",
      "speaker_role": "narrator",
      "spoken_text": "Unlike other sea turtles, a leatherback lacks a hard bony shell.",
      "fact_ids": [
        "shell"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg3",
      "speaker_role": "narrator",
      "spoken_text": "Instead, leathery skin covers connective tissue and overlapping dermal bones.",
      "fact_ids": [
        "shell"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg4",
      "speaker_role": "narrator",
      "spoken_text": "Seven longitudinal ridges run down the carapace, giving it a distinctive shape.",
      "fact_ids": [
        "ridges"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg5",
      "speaker_role": "narrator",
      "spoken_text": "Leatherbacks primarily eat jellyfish and other soft-bodied prey.",
      "fact_ids": [
        "diet"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg6",
      "speaker_role": "narrator",
      "spoken_text": "Pointed jaws help them grasp slippery prey.",
      "fact_ids": [
        "adaptation"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg7",
      "speaker_role": "narrator",
      "spoken_text": "Backward-pointing mouth and throat papillae help retain prey as water flows out.",
      "fact_ids": [
        "adaptation"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "seg8",
      "speaker_role": "narrator",
      "spoken_text": "The largest living sea turtle has a distinctive shell and jaws that help it grasp soft prey.",
      "fact_ids": [
        "shell",
        "ridges",
        "adaptation"
      ],
      "delivery": "emphatic"
    }
  ],
