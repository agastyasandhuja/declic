{
  "schema_version": "1",
  "title": "The universe has a structure",
  "segments": [
    {
      "segment_id": "s1",
      "speaker_role": "narrator",
      "spoken_text": "If the universe is a web, what are its strings made of?",
      "fact_ids": [
        "web",
        "scale"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s2",
      "speaker_role": "narrator",
      "spoken_text": "Start with one galaxy: stars, gas, dust and dark matter, held together by gravity.",
      "fact_ids": [
        "galaxy"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s3",
      "speaker_role": "narrator",
      "spoken_text": "That was a sketch. A telescope shows a real one.",
      "fact_ids": [
        "galaxy"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s4",
      "speaker_role": "narrator",
      "spoken_text": "Stars belong to galaxies. Galaxies gather into groups and clusters.",
      "fact_ids": [
        "clusters",
        "hierarchy"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s5",
      "speaker_role": "narrator",
      "spoken_text": "A telescope image of a cluster shows many galaxies gathered together.",
      "fact_ids": [
        "clusters"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s6",
      "speaker_role": "narrator",
      "spoken_text": "Why do they gather? Gravity pulls matter together and helps this structure develop over time.",
      "fact_ids": [
        "gravity"
      ],
      "delivery": "curious"
    },
    {
      "segment_id": "s7",
      "speaker_role": "narrator",
      "spoken_text": "In this illustrative, not-to-scale view, galaxies on large scales trace filaments and sheets.",
      "fact_ids": [
        "web",
        "scale"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s8",
      "speaker_role": "narrator",
      "spoken_text": "Those filaments and sheets surround immense, relatively empty voids.",
      "fact_ids": [
        "web"
      ],
      "delivery": "neutral"
    },
    {
      "segment_id": "s9",
      "speaker_role": "narrator",
      "spoken_text": "Matter, not strings or a solid wall: galaxies trace the web.",
      "fact_ids": [
        "web",
        "scale"
      ],
      "delivery": "emphatic"
    }
  ],
