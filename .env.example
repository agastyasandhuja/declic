# déclic environment setup
# The fixture mobile preview only needs:
#   cp apps/mobile/.env.example apps/mobile/.env
#
# For the integrated demo, see docs/RUN_DEMO.md. Copy the service-specific files:
#   cp services/api/.env.example services/api/.env
#   cp services/api/.env.gemini.example services/api/.env.gemini.local
# Add optional video settings from services/api/.env.video.example to the API env.
#
# The API also reads a root .env as an optional override. Leave the root .env
# absent if you use the service-specific defaults. This file is a template.
# Never put service-role keys, provider secrets, or tokens in EXPO_PUBLIC_*.
# VIDEO_GENERATION_ENABLED=false
